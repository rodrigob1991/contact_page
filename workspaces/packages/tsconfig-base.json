{
  "compilerOptions": {
   "target": "ES2022",                             /* Target modern JS, or lower (e.g., ES2020) depending on consumer matrix */
    "lib": ["ES2022"],                             /* Omit "dom" if it's a pure backend/Node library */

    /* Modules & Resolution */
    "module": "NodeNext",                           /* Best for modern ESM/CJS dual-package or pure ESM libraries */
    "moduleResolution": "NodeNext",                 /* Pairs with NodeNext module emit */

    /* Emit (Crucial for Libraries) */
    "declaration": true,                            /* Generates corresponding '.d.ts' file for consumers */
    "declarationMap": true,                         /* Maps d.ts files back to source code for easier debugging */
    "sourceMap": true,                              /* Generates source map files for JS debugging */
    "outDir": "./dist",                             /* Redirect output structure to the directory */
    "rootDir": "./src",                             /* Specify the root folder of source files */

    /* Strictness & Safety */
    "strict": true,                                 /* Enable all strict type-checking options */
    "noUncheckedIndexedAccess": true,               /* Ensures array/record access includes 'undefined' checking */
    "verbatimModuleSyntax": true,                   /* Enforces clean, predictable import/export syntax for types */

    /* Interop & Performance */
    "esModuleInterop": true,                        /* Emits additional JavaScript to ease importing CommonJS modules */
    "skipLibCheck": true                            /* Skip type checking of declaration files (.d.ts) for speed */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/__tests__/*", "**/*.test.ts"]
}