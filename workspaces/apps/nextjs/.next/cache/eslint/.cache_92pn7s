il.tsx":"23","/home/rodrigo/projects/contact_page/apps/nextjs/src/components/home/presentation/PresentationView.tsx":"24","/home/rodrigo/projects/contact_page/apps/nextjs/src/components/home/presentation/SkillsChart.tsx":"25","/home/rodrigo/projects/contact_page/apps/nextjs/src/components/home/stories/StoriesView.tsx":"26","/home/rodrigo/projects/contact_page/apps/nextjs/src/dimensions.ts":"27","/home/rodrigo/projects/contact_page/apps/nextjs/src/hooks/useWebSocket.ts":"28","/home/rodrigo/projects/contact_page/apps/nextjs/src/middleware.ts":"29","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/404.tsx":"30","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/500.tsx":"31","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/_app.tsx":"32","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/api/internal/unauthorized.ts":"33","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/api/protected/props/home/presentation.ts":"34","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/api/protected/props/home/story.ts":"35","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/api/protected/props/home.ts":"36","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/api/protected/revalidate/multiple.ts":"37","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/index.tsx":"38","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/user/chat.tsx":"39","/home/rodrigo/projects/contact_page/apps/nextjs/src/pages/user/edit_home.tsx":"40","/home/rodrigo/projects/contact_page/apps/nextjs/src/types/chat.ts":"41","/home/rodrigo/projects/contact_page/apps/nextjs/src/types/home.ts":"42","/home/rodrigo/projects/contact_page/apps/nextjs/src/types/index.d.ts":"43","/home/rodrigo/projects/contact_page/apps/nextjs/src/types/revalidation.ts":"44","/home/rodrigo/projects/contact_page/apps/nextjs/src/utils/DomManipulations.ts":"45","/home/rodrigo/projects/contact_page/apps/nextjs/src/utils/Hooks.tsx":"46","/home/rodrigo/projects/contact_p