ts":"76","hashOfConfig":"49"},{"size":1329,"mtime":1680741172938,"results":"77","hashOfConfig":"49"},{"size":384,"mtime":1679588945265,"results":"78","hashOfConfig":"49"},{"size":391,"mtime":1679588945265,"results":"79","hashOfConfig":"49"},{"size":288,"mtime":1679588945265,"results":"80","hashOfConfig":"49"},{"size":424,"mtime":1679686236132,"results":"81","hashOfConfig":"49"},{"size":3735,"mtime":1679588945265,"results":"82","hashOfConfig":"49"},{"size":4235,"mtime":1686333927264,"results":"83","hashOfConfig":"49"},{"size":3707,"mtime":1680060580390,"results":"84","hashOfConfig":"49"},{"size":3208,"mtime":1679686235864,"results":"85","hashOfConfig":"49"},{"size":2019,"mtime":1681325855981,"results":"86","hashOfConfig":"49"},{"size":1283,"mtime":1684524920877,"results":"87","hashOfConfig":"49"},{"size":16446,"mtime":1679686235980,"results":"88","hashOfConfig":"49"},{"size":5370,"mtime":1684345718975,"results":"89","hashOfConfig":"49"},{"size":4000,"mtime":1686403228357,"results":"90","hashOfConfig":"49"},{"size":145,"mtime":1679588945269,"results":"91","hashOfConfig":"49"},{"size":284,"mtime":1679588945269,"results":"92","hashOfConfig":"49"},{"size":5712,"mtime":1686405358636,"results":"93","hashOfConfig":"49"},{"size":4561,"mtime":1686411624334,"results":"94","hashOfConfig":"49"},{"size":4988,"mtime":1679588945269,"results":"95","hashOfConfig":"49"},{"filePath":"96","messages":"97","suppressedMessages":"98","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"1284uhm",{"filePath":"99","messages":"100","suppressedMessages":"101","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"102","messages":"103","suppressedMessages":"104","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"105","messages":"106","suppressedMessages":"107","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"